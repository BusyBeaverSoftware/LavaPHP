{
    "name": "lava/blog",
    "description": "A blog with sign-in, built on LavaPHP the way a consumer builds one — hand-written session auth, three packs, and an error page of its own. Never published.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "lava/core": "^0.1.0",
        "lava/db": "^0.1.0",
        "lava/validate": "^0.1.0",
        "lava/view": "^0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "repositories": {
        "lava/core": {
            "type": "path",
            "url": "../../packages/core",
            "options": { "versions": { "lava/core": "0.1.0" } }
        },
        "lava/db": {
            "type": "path",
            "url": "../../packages/db",
            "options": { "versions": { "lava/db": "0.1.0" } }
        },
        "lava/validate": {
            "type": "path",
            "url": "../../packages/validate",
            "options": { "versions": { "lava/validate": "0.1.0" } }
        },
        "lava/view": {
            "type": "path",
            "url": "../../packages/view",
            "options": { "versions": { "lava/view": "0.1.0" } }
        }
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
