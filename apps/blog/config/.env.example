# Copy this file to `config/.env` and edit it: `cp config/.env.example config/.env`
#
# Read at boot, and promoted into the process environment only for names the real
# environment does not already define — a real env var always wins, so a
# deployment never has to edit this file. `lava env` shows every variable the app
# reads, where its value came from, and which layer decided.

# Names the environment (dev, staging, prod). Selects a per-env flag branch, and
# is what `lava <command> --env=<name>` overrides for one invocation.
LAVA_ENV=dev

# Signs the session cookie. REQUIRED — the app refuses to boot without it,
# because a cookie signed with an empty key is a cookie anyone can forge.
#
# Generate one:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
SESSION_SECRET=

# Where the database lives. Defaults to var/blog.sqlite inside the app
# directory; uncomment to point somewhere else (see config/database.php).
# DATABASE_DSN=sqlite:/absolute/path/to/blog.sqlite

# Turn registration off without a deploy: the /register route 404s and the link
# disappears from the page, because both ask the same flag resolver.
# LAVA_FEATURE_SIGNUPS_OPEN=off
