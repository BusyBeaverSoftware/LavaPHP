{% extends 'layout.twig' %}

{% block title %}Register{% endblock %}

{% block content %}
  <h1>Create an account</h1>

  {% if errors._form is defined %}
    <p class="error">{{ errors._form }}</p>
  {% endif %}

  <form method="post" action="{{ url('register.submit') }}">
    <input type="hidden" name="csrf" value="{{ csrf }}">

    <label for="email">Email</label>
    <input id="email" type="email" name="email" value="{{ values.email }}" required>
    {% if errors.email is defined %}<p class="error">{{ errors.email }}</p>{% endif %}

    <label for="display_name">Display name</label>
    <input id="display_name" type="text" name="display_name" value="{{ values.display_name }}" maxlength="60" required>
    {% if errors.display_name is defined %}<p class="error">{{ errors.display_name }}</p>{% endif %}

    <label for="password">Password</label>
    <input id="password" type="password" name="password" required>
    {% if errors.password is defined %}<p class="error">{{ errors.password }}</p>{% endif %}

    <label for="password_confirm">Repeat password</label>
    <input id="password_confirm" type="password" name="password_confirm" required>
    {% if errors.password_confirm is defined %}<p class="error">{{ errors.password_confirm }}</p>{% endif %}

    <button type="submit">Create account</button>
  </form>

  <p class="muted">Already have an account? <a href="{{ url('login') }}">Sign in</a>.</p>
{% endblock %}
