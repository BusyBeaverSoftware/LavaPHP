{
    "name": "lava/demo",
    "description": "LavaPHP's canonical app — a tasks service that dogfoods every pillar and every pack, and the app the framework's own acceptance runs are executed against.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "lava/core": "@dev",
        "lava/db": "@dev",
        "lava/validate": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "repositories": {
        "lava/core": { "type": "path", "url": "../../packages/core" },
        "lava/db": { "type": "path", "url": "../../packages/db" },
        "lava/validate": { "type": "path", "url": "../../packages/validate" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
