{
    "name": "lavaphp/demo",
    "description": "LavaPHP's canonical app — a tasks service that dogfoods every pillar and every pack, and the app the framework's own acceptance runs are executed against.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "lavaphp/core": "^0.2.0",
        "lavaphp/db": "^0.2.0",
        "lavaphp/http-client": "^0.2.0",
        "lavaphp/validate": "^0.2.0",
        "lavaphp/view": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "repositories": {
        "lavaphp/core": {
            "type": "path",
            "url": "../../packages/core",
            "options": { "versions": { "lavaphp/core": "0.2.0" } }
        },
        "lavaphp/db": {
            "type": "path",
            "url": "../../packages/db",
            "options": { "versions": { "lavaphp/db": "0.2.0" } }
        },
        "lavaphp/validate": {
            "type": "path",
            "url": "../../packages/validate",
            "options": { "versions": { "lavaphp/validate": "0.2.0" } }
        },
        "lavaphp/view": {
            "type": "path",
            "url": "../../packages/view",
            "options": { "versions": { "lavaphp/view": "0.2.0" } }
        },
        "lavaphp/http-client": {
            "type": "path",
            "url": "../../packages/http-client",
            "options": { "versions": { "lavaphp/http-client": "0.2.0" } }
        }
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
