# Copy this file to `.env` and edit it: `cp config/.env.example config/.env`
#
# Read at boot, and promoted into the process environment only for names the
# real environment does not already define — a real env var always wins, so a
# deployment never has to edit this file. `lava env` shows every variable this
# app reads, where its value came from, and which layer decided.
#
# This app runs with none of these set: `config/database.php` defaults to a
# SQLite file under `var/`, and every flag has a code default. They are here to
# be uncommented, not because anything is missing.

# Names the environment (dev, staging, prod). It selects a per-env flag branch
# and is what `lava <command> --env=<name>` overrides for one invocation.
LAVA_ENV=dev

# The database. Overrides config/database.php entirely, and is the only way to
# point a deployment at a server. A password in a DSN is redacted before it
# reaches a problem report, but a separate variable is still the better habit.
# DATABASE_DSN=mysql:host=127.0.0.1;dbname=tasks
# DATABASE_USER=tasks
# DATABASE_PASSWORD=

# A flag override. The name is the flag upper-cased; an unknown name here is a
# boot problem, never a silent no-op.
# LAVA_FEATURE_TASKS_CSV_EXPORT=off
