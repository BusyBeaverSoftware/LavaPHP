{% extends 'layout.twig' %}

{% block title %}Task {{ task.id }}{% endblock %}

{% block content %}
  <h1 class="{{ task.done ? 'done' : '' }}">{{ task.title }}</h1>

  <dl>
    <dt>id</dt><dd>{{ task.id }}</dd>
    <dt>state</dt><dd>{{ task.done ? 'done' : 'open' }}</dd>
    <dt>due</dt><dd>{{ task.dueOn ?? '—' }}</dd>
    <dt>created</dt><dd>{{ task.createdAt }}</dd>
  </dl>

  <p class="muted">
    <a href="{{ url('home') }}">← all tasks</a> ·
    <a href="{{ url('tasks.show', {id: task.id}) }}">this task as JSON</a>
  </p>
{% endblock %}
