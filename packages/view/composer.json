{
    "name": "lavaphp/view",
    "description": "LavaPHP view pack — Twig integration with strict defaults, autoescaping on, and an explicit function registry.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "lavaphp/core": "^0.7.0",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "Lava\\View\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Lava\\View\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}