{
    "name": "lava/app",
    "description": "LavaPHP application skeleton — the composer create-project target. Boots green with zero configuration.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "lava/core": "^0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}