{
    "name": "lava/validate",
    "description": "LavaPHP validate pack — typed validation DSL where every rule failure carries a field-scoped fix hint.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "lava/core": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "repositories": {
        "lava/core": { "type": "path", "url": "../core" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "Lava\\Validate\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Lava\\Validate\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}