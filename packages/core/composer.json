{
    "name": "lava/core",
    "description": "LavaPHP core — agent-first micro-framework kernel: self-diagnosing boot, explicit DI, mandatory-name routing, deterministic feature flags.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "bin": ["bin/lava"],
    "autoload": {
        "psr-4": { "Lava\\Core\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Lava\\Core\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}