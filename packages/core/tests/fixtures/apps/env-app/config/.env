# APP_REGION is declared by the app; UNCLAIMED is declared by nobody, and
# `lava env` must still show it — an undeclared entry is invisible everywhere
# else, which is exactly when it needs to be visible.
APP_REGION=eu-west-1
UNCLAIMED=1
# Undeclared AND named like a credential: `lava env` redacts it by the name
# heuristic, and every other view of it must do the same.
UNCLAIMED_API_KEY=undeclared-fixture-key
