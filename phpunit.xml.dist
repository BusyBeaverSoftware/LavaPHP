<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true">
  <testsuites>
    <!--
      fixtures/apps/* are whole apps, each with its OWN suite that `lava test`
      runs as a subprocess (a real app's suite, run the way a real app runs it).
      Collecting them here would run them twice, in one shared process where
      two fixtures declaring the same App\ class is an uncatchable fatal.
    -->
    <testsuite name="core">
      <directory>packages/core/tests</directory>
      <exclude>packages/core/tests/fixtures</exclude>
    </testsuite>
    <testsuite name="db"><directory>packages/db/tests</directory></testsuite>
    <testsuite name="validate"><directory>packages/validate/tests</directory></testsuite>
    <testsuite name="view"><directory>packages/view/tests</directory></testsuite>
    <testsuite name="http-client"><directory>packages/http-client/tests</directory></testsuite>
    <testsuite name="events"><directory>packages/events/tests</directory></testsuite>
  </testsuites>
  <source>
    <include>
      <directory>packages/core/src</directory>
      <directory>packages/db/src</directory>
      <directory>packages/validate/src</directory>
      <directory>packages/view/src</directory>
      <directory>packages/http-client/src</directory>
      <directory>packages/events/src</directory>
    </include>
  </source>
</phpunit>