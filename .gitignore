/vendor/
# A pack installed on its own (`cd packages/<pack> && composer install`) gets its own vendor/.
# That install is how a pack's standalone claim is verified, not an artifact to commit.
/packages/*/vendor/
# lava/app is the one package of type "project", so it is the one that CAN have a
# lock — and the one that must not commit it: the lock this monorepo generates
# pins lava/core to a `../core` PATH repository, which does not exist in a
# published skeleton. `composer create-project lava/app` has to resolve
# lava/core from packagist, so it must ship no lock at all.
/packages/app/composer.lock
/composer.phar
/.phpunit.cache/
.phpunit.result.cache
/.phpstan-cache/
.env
!config/.env.example
# Fixture apps are test data — their .env files must be tracked, or CI boots different fixtures than local runs.
# Every pack's fixtures, not just core's: a pack's fixture app is the same kind of artifact.
!packages/*/tests/fixtures/**
*.log
# Fixture apps write their own cache when `lava test` runs their suite.
.phpunit.cache/
